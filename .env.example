# Copiá este archivo como ".env" y completá. ".env" NO se sube a GitHub.
# Todo es opcional: sin nada, la app funciona pegando links.

# Puerto del servidor (por defecto 3000)
# PORT=3000

# Buscador por nombre: clave de YouTube Data API v3 (gratis)
# YOUTUBE_API_KEY=TU_CLAVE

# Códigos de acceso a la búsqueda: nombre:codigo (mínimo 8 caracteres), separados por coma
# SEARCH_ACCESS_CODES=vos:codigo-largo-uno,amigo:codigo-largo-dos

# Abrir la búsqueda a cualquiera (ojo con el cupo diario)
# SEARCH_PUBLIC=1

# Tope diario propio de búsquedas (por defecto 90)
# SEARCH_DAILY_MAX=90

# Por defecto, abrir la app en http://localhost:3000 (la misma PC que la hospeda) no pide código de búsqueda.
# Poné 0 para que también lo pida ahí.
# LOCAL_OWNER_SEARCH=0
